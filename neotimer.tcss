TimerDisplay {
	text-align: center;
	background: transparent;
}

AvgandLastSolve {
	width: 100%;
	dock: bottom;
	height: auto;
}

Average {
	width: 1fr; /*Take up all available space horizontally, so LastSolve gets pushed to right edge*/
}

NotificationCenter {
	dock: top;
	text-align: right;
	width: 1fr;
	align: right top;
}

Screen {
	align: center middle;
	width: auto;
}